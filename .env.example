# Firebase — Project settings → Your apps → Web (apiKey)
# Authentication → Sign-in method → habilitar Google
VITE_FIREBASE_API_KEY=

# Dev móvil (Capacitor + Vite): si Google vuelve a http://localhost sin puerto, forzá el puerto del dev server
# VITE_DEV_CLIENT_PORT=5173
# Si usás la IP de la PC en capacitor.config server.url, agregala (coma-separado):
# VITE_DEV_ORIGIN_HOSTNAMES=localhost,127.0.0.1,10.0.2.2,192.168.0.15

# Capacitor live reload (solo si corrés `npm run cap:sync:dev` a mano). Emulador Android por defecto: 10.0.2.2:5173
# Teléfono físico: poné la IP de tu PC y en Firebase → Auth → dominios autorizados agregá esa IP
# CAPACITOR_DEV_SERVER_URL=http://192.168.0.15:5173

# Aviationstack (vuelo en destinos guardados en Mis viajes). Plan gratuito: pocas consultas/mes.
# CORS: en dev Vite reenvía /api/aviationstack; en producción estática suele hacer falta un proxy.
#
# Seguridad: si la clave está en VITE_* se embebe en el bundle y el navegador la envía en cada request
# (visible en herramientas de red). Para usuarios finales en la web, la forma correcta es un proxy
# server-side (p. ej. Cloud Function / API propia) que guarde la access_key solo en el servidor.
# VITE_AVIATIONSTACK_ACCESS_KEY=
