rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y escribir su propio árbol de datos.
    // Sin login (request.auth == null) → acceso denegado a todo.
    // Cloud Functions usan Admin SDK y bypasean estas reglas.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Tabla pública de códigos de referido.
    // Lectura libre (para validar un código al registrarse).
    // Escritura solo del propio usuario (el uid del doc debe coincidir).
    match /referidos/{codigo} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Cualquier otra colección en la raíz está bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
